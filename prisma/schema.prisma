model Malzeme {
  id          String     @id @default(cuid())
  cins        String     // Malzeme Cinsi
  marka       String?    // BELGE SAHİBİ KURULUŞUN ADI VE TESCİLLİ TİCARİ MARKASI
  onayDurumu  String?    @default("Sunuldu") // Sunuldu, Onay Bekliyor, Onaylandı, Reddedildi
  
  standartlar Standart[] 
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Standart {
  id               String  @id @default(cuid())
  ad               String  // Standart numarası (Örn: TS EN 10255)
  belgeNo          String? // Belge No
  gecerlilikTarihi String? // Son geçerlilik tarihi
  
  malzemeId        String
  malzeme          Malzeme @relation(fields: [malzemeId], references: [id], onDelete: Cascade)
}